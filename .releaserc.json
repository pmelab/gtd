{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "npm version ${nextRelease.version} --no-git-tag-version --allow-same-version && node scripts/sync-plugin-version.mjs && npm run build",
        "publishCmd": "npm publish --access public --provenance --tag next"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": ["package.json", "package-lock.json", ".claude-plugin/plugin.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/gtd.bundle.mjs",
            "name": "gtd.bundle.mjs"
          }
        ],
        "successComment": false,
        "failComment": false
      }
    ]
  ]
}
