{
  "permissions": {
    "allow": [
      "Bash(npx vp run check)",
      "Bash(npx vp run test:unit)",
      "Bash(npm run test:e2e)",
      "Bash(npm test)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx vitest run --project unit *)",
      "Bash(npx vitest run --project e2e *)",
      "Bash(npx vp run check *)",
      "Bash(npx vp run test:unit *)",
      "Bash(npx vitest run *)",
      "Bash(npx fallow health *)",
      "Bash(npx fallow --summary *)",
      "Bash(npx fallow --quiet *)",
      "Bash(npx fallow)",
      "Bash(npx fallow --summary)",
      "Bash(npx vp check)",
      "Bash(npx vp fmt --check)",
      "Bash(npx vp fmt --check *)",
      "Bash(gtd next*)",
      "Bash(gtd status*)",
      "Bash(gtd validate*)",
      "Bash(gtd visualize --json*)",
      "Bash(gtd version*)",
      "Bash(npx vp run build)",
      "mcp__github__actions_list"
    ],
    "deny": ["Bash(npm run test:mutation)", "Bash(npx stryker run)", "Bash(stryker run)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx vp fmt --no-error-on-unmatched-pattern \"$CLAUDE_TOOL_INPUT_FILE_PATH\""
          }
        ]
      }
    ]
  }
}
