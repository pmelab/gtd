{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/main.{ts,tsx,js,jsx}",
    // The browser-platform tsdown entry (src/web/*) is a second bundle root
    // built independently of src/main.ts's node bundle — never imported by it.
    "src/web/main.tsx",
    // NOT `.storybook/main.ts`/`preview.ts`/`*.stories.tsx`: fallow's own
    // built-in `storybook` plugin (see `fallow list`'s "Active plugins")
    // already discovers those as entry points from `.storybook/main.ts`'s
    // `stories:` glob — a manual entry here would be redundant with, not a
    // substitute for, that plugin. Verify with `npx fallow list` if this
    // stops holding (e.g. plugin detection changes upstream).
    // Vitest loads support files via setupFiles in vitest.config.ts — declare them
    // so fallow treats them as entry points rather than dead files.
    "tests/integration/support/**/*.{ts,mjs}",
    // Vitest loads the reporter via a string path in vitest.config.ts.
    "tests/vitest.reporter.ts",

    // Vitest config for Stryker mutation testing — loaded by Stryker CLI, not imported.
    "vitest.stryker.config.ts",

    // evals/ is a plain-.mjs promptfoo config, not imported by anything —
    // its own files are entry points, not dead code.
    "evals/*.mjs",
    // Copied into each eval fixture repo as its gtd.config.ts.
    "evals/gtd.config.ts"
  ],
  "duplicates": {
    // Hide pair-only clones; focus on widespread copy-paste worth refactoring.
    "minOccurrences": 3
  },
  // src/web/index.html's <link rel="stylesheet" href="./main.css" /> points at
  // a build-time artifact the Tailwind CLI writes to dist/web/main.css (see
  // package.json's build script) — there is no src/web/main.css for fallow to
  // resolve, by design (same reason dist/web/main.js is never a source file
  // either).
  // Same for src/ui/Server.ts's `import ... from "../web/generated.html"`: that
  // file is written by scripts/inline-web-client.mjs during `build` and is
  // gitignored, so it is absent on a fresh checkout when `analyze` runs.
  "ignoreUnresolvedImports": ["**/main.css", "**/generated.html"],
  // jiti is a peer requirement of eslint's TypeScript config loader, not a direct import.
  // Stryker packages are CLI tools invoked via npx/scripts, not imported in TypeScript source.
  // promptfoo is spawned as a CLI binary from evals/eval.mjs's own child_process call, never
  // `require`d/`import`ed and never named in a package.json script fallow's own scan can see.
  // @earendil-works/pi-coding-agent is spawned the same way from evals/run-turn.mjs.
  // react/react-dom/@tanstack/react-query/@trpc/client/@trpc/react-query are imported from
  // production `src/web/**` source but deliberately stay `devDependencies`, never
  // `dependencies` — they're inlined into `src/web/generated.html` at BUILD time
  // (`tsdown.config.ts`'s `web` bundle) and never required unbundled at runtime.
  // `tests/tooling/turbo.test.ts`'s own "keeps browser-only web-client packages out of
  // dependencies" test pins this the other way from fallow's own default heuristic.
  "ignoreDependencies": [
    "jiti",
    "@stryker-mutator/core",
    "@stryker-mutator/vitest-runner",
    "@stryker-mutator/typescript-checker",
    "promptfoo",
    "@earendil-works/pi-coding-agent",
    "react",
    "react-dom",
    "@tanstack/react-query",
    "@trpc/client",
    "@trpc/react-query",
    "tailwind-merge",
    // @radix-ui/colors is never imported: src/web/palette.test.ts READS its
    // CSS files as data to check that every token in styles.css still equals
    // the Radix step it claims. fallow only sees imports, so without this it
    // reports the package as unused.
    "@radix-ui/colors"
  ]
}
