{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-restricted-globals": [
      "error",
      {
        "name": "fetch",
        "message": "The engine never grows a network dependency — fetch lives only under src/judges/providers/"
      }
    ],
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "**/testing/*",
              "./testing/*",
              "../testing/*",
              "**/testkit/*",
              "./testkit/*",
              "../testkit/*"
            ],
            "message": "src/testkit/** and src/web/testing/** are test-only and must never reach src/main.ts's import graph"
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/judges/providers/**", "tests/**"],
      "rules": {
        "no-restricted-globals": "off"
      }
    },
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "require-yield": "off",
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["src/testkit/**", "**/*.steps.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      // `.stories.tsx` files are exactly as test-only as `.test.ts` — never
      // part of `src/main.ts`'s production import graph (Storybook-only,
      // excluded from `npm run build`) — so `src/web/testing/**` helpers
      // built for them need the same carve-out `src/testkit/**` gets.
      "files": ["**/*.stories.tsx"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["tests/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "ignorePatterns": ["dist", "node_modules", "scripts", ".stryker-tmp", "reports"]
}
