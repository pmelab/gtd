{
  "$schema": "https://cdn.jsdelivr.net/npm/@pmelab/gtd/schema.json",
  "modes": {
    "qa": {
      "format": "npx oxfmt --no-error-on-unmatched-pattern --write \"$GTD_FILE\"",
      "validate": "node ./dist/gtd.bundle.mjs check qa \"$GTD_FILE\""
    },
    "review": {
      "format": "npx oxfmt --no-error-on-unmatched-pattern --write \"$GTD_FILE\"",
      "validate": "node ./dist/gtd.bundle.mjs check review \"$GTD_FILE\""
    }
  },
  "ui": {
    "format": "npx oxfmt --no-error-on-unmatched-pattern --write \"$GTD_FILE\""
  },
  "env": {
    "fastTestCommand": "npm run test:fast"
  }
}
