{
  "$schema": "https://cdn.jsdelivr.net/npm/@pmelab/gtd/schema.json",
  "vars": {
    "testCommand": "npm test",
    "todoFile": "TODO.md",
    "requirementsFile": "REQS.md",
    "architectureFile": "ARCH.md",
    "reviewFile": "REVIEW.md"
  },
  "modes": {
    "qa": {
      "format": "npx prettier --write <%= it.file %>"
    },
    "review": {
      "format": "npx prettier --write <%= it.file %>"
    },
    "prose": {
      "format": "npx prettier --write <%= it.file %>"
    }
  }
}
