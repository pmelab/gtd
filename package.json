{
  "name": "@pmelab/gtd",
  "version": "10.3.0",
  "private": false,
  "description": "Git-aware CLI that emits the next prompt for an autonomous coding agent based on the current repository state",
  "bin": {
    "gtd": "dist/gtd.bundle.mjs"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "schema.json"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pmelab/gtd.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "packageManager": "npm@11.17.0",
  "scripts": {
    "prepare": "husky",
    "dev": "node dev/run.mjs",
    "build": "tsdown",
    "postbuild": "jiti scripts/generate-schema.ts && node scripts/assert-no-test-doubles.mjs",
    "watch": "tsdown --watch",
    "test": "turbo run format:check typecheck lint lint:sh test:unit test:e2e:inmem test:e2e:live deadcode",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "test:changed": "vitest run --project unit --project e2e-inmem --changed HEAD",
    "test:e2e": "npm run test:e2e:inmem && npm run test:e2e:live",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:sh": "jiti scripts/generate-shell-corpus.ts --check && shellcheck -s sh tests/shell/corpus/*.sh",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:mutation": "stryker run",
    "test:e2e:inmem": "vitest run --project e2e-inmem",
    "test:e2e:live": "vitest run --project e2e-live --no-file-parallelism",
    "deadcode": "fallow --summary --quiet",
    "coverage": "vitest run --project unit --coverage",
    "eval": ": \"${GTD_EVALS_URL:?GTD_EVALS_URL is required — the OpenAI-compatible gateway every graded turn and the judge run through}\" && : \"${GTD_EVALS_KEY:?GTD_EVALS_KEY is required — the gateway bearer key}\" && npx turbo run build && node evals/eval.mjs",
    "eval:baseline": "node evals/compare-baseline.mjs --record"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern --write"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@effect/language-service": "^0.72.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^12.0.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^3.2.7",
    "fallow": "^3.14.0",
    "fast-check": "^4.8.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "prettier": "^3.8.1",
    "promptfoo": "0.122.1",
    "quickpickle": "1.11.2",
    "semantic-release": "^25.0.5",
    "tsdown": "^0.22.8",
    "turbo": "^2.10.9",
    "vitest": "^3.2.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@effect/platform": "^0.94.2",
    "@effect/platform-node": "^0.104.1",
    "cosmiconfig": "^9.0.2",
    "effect": "^3.19.15",
    "eta": "^4.6.0",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.13",
    "yaml": "^2.8.2"
  }
}
