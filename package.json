{
  "name": "@pmelab/gtd",
  "version": "24.0.0",
  "private": false,
  "description": "Git-aware CLI that emits the next prompt for an autonomous coding agent based on the current repository state",
  "bin": {
    "gtd": "dist/gtd.bundle.mjs"
  },
  "exports": {
    "./flows": {
      "types": "./src/flows/index.ts",
      "source": "./src/flows/index.ts",
      "default": "./dist/flows.mjs"
    },
    "./wire": {
      "types": "./src/wire/index.ts",
      "source": "./src/wire/index.ts",
      "default": "./dist/wire.mjs"
    },
    "./steering": {
      "types": "./src/steering/index.ts",
      "source": "./src/steering/index.ts",
      "default": "./dist/steering.mjs"
    },
    "./workflow-kit": {
      "types": "./src/workflow-kit/index.ts",
      "source": "./src/workflow-kit/index.ts",
      "default": "./dist/workflow-kit.mjs"
    },
    "./workflows": {
      "types": "./src/workflows/index.ts",
      "source": "./src/workflows/index.ts",
      "default": "./dist/workflows.mjs"
    },
    "./workflows/feature": {
      "types": "./src/workflows/feature/index.ts",
      "source": "./src/workflows/feature/index.ts",
      "default": "./dist/workflows/feature.mjs"
    },
    "./workflows/review": {
      "types": "./src/workflows/review/index.ts",
      "source": "./src/workflows/review/index.ts",
      "default": "./dist/workflows/review.mjs"
    },
    "./workflows/fix": {
      "types": "./src/workflows/fix/index.ts",
      "source": "./src/workflows/fix/index.ts",
      "default": "./dist/workflows/fix.mjs"
    },
    "./workflow": {
      "types": "./src/workflows/index.ts",
      "source": "./src/workflows/index.ts",
      "default": "./dist/workflows.mjs"
    },
    "./testkit": {
      "types": "./src/testkit/index.ts",
      "source": "./src/testkit/index.ts",
      "default": "./dist/testkit.mjs"
    }
  },
  "files": [
    "dist/",
    "src/flows/",
    "src/workflows/",
    "src/workflow-kit/",
    "src/wire/",
    "src/steering/",
    "src/testkit/",
    "src/cli/",
    "src/edge/",
    "src/emit/",
    "src/install/",
    "src/platform/",
    "src/replay/",
    "src/step/",
    "src/workflow/",
    "README.md",
    "LICENSE",
    ".claude-plugin/plugin.json",
    "hooks/",
    "bin/",
    "claude/hooks/",
    "claude/types/",
    "!claude/**/*.test.ts",
    "skills/"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pmelab/gtd.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "packageManager": "npm@11.17.0",
  "scripts": {
    "prepare": "husky",
    "dev": "node dev/run.mjs",
    "build": "tsdown --filter web && npx @tailwindcss/cli -i src/web/styles.css -o dist/web/main.css --minify && node scripts/inline-web-client.mjs && tsdown --filter gtd && tsdown --filter workflows && tsdown --filter entrypoints",
    "postbuild": "node scripts/assert-no-test-doubles.mjs",
    "watch": "tsdown --watch",
    "bench:replay": "node scripts/bench-replay.mjs",
    "test": "turbo run format:check typecheck lint lint:sh lint:boundaries test:unit test:workflows test:e2e:inmem test:e2e:live test:web analyze",
    "test:fast": "turbo run format:check typecheck lint lint:sh lint:boundaries test:unit test:workflows test:web analyze",
    "test:unit": "vitest run --project unit",
    "test:workflows": "vitest run --project workflows",
    "test:watch": "vitest",
    "test:changed": "vitest run --project unit --project e2e-inmem --project workflows --changed HEAD",
    "test:e2e": "npm run test:e2e:inmem && npm run test:e2e:live",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/tsconfig.json",
    "lint": "oxlint .",
    "lint:sh": "jiti scripts/generate-shell-corpus.ts --check && shellcheck -s sh tests/shell/corpus/*.sh",
    "lint:boundaries": "depcruise src tests claude",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:mutation": "stryker run",
    "test:e2e:inmem": "vitest run --project e2e-inmem",
    "test:e2e:live": "vitest run --project e2e-live --no-file-parallelism",
    "analyze": "fallow --summary --quiet",
    "test:web": "vitest run --project storybook",
    "storybook": "storybook dev --host 0.0.0.0",
    "coverage": "vitest run --project unit --coverage",
    "eval": ": \"${GTD_EVALS_URL:?GTD_EVALS_URL is required \u2014 the OpenAI-compatible gateway every graded turn and the judge run through}\" && : \"${GTD_EVALS_KEY:?GTD_EVALS_KEY is required \u2014 the gateway bearer key}\" && npx turbo run build && node evals/eval.mjs",
    "eval:baseline": "node evals/compare-baseline.mjs --record"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@effect/language-service": "^0.72.0",
    "@radix-ui/colors": "^3.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^12.0.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/typescript-checker": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser": "^3.2.7",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^18.3.1",
    "fallow": "3.25.0",
    "fast-check": "^4.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "playwright": "^1.62.1",
    "prettier": "^3.8.1",
    "promptfoo": "0.122.1",
    "quickpickle": "1.11.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "semantic-release": "^25.0.5",
    "storybook": "^10.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.8",
    "turbo": "^2.10.9",
    "vitest": "^3.2.0",
    "yaml": "^2.8.2",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "quickpickle": ">=1.11.2",
    "typescript": "^5",
    "vitest": ">=3.2.0"
  },
  "peerDependenciesMeta": {
    "quickpickle": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@effect/platform": "^0.94.2",
    "@effect/platform-node": "^0.104.1",
    "@standard-schema/spec": "^1.1.0",
    "@trpc/server": "^11.18.0",
    "effect": "^3.19.15",
    "jiti": "^2.7.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm-autolink-literal": "^2.0.1",
    "mdast-util-gfm-footnote": "^2.1.0",
    "mdast-util-gfm-strikethrough": "^2.0.1",
    "mdast-util-gfm-task-list-item": "^2.0.0",
    "micromark-extension-gfm-autolink-literal": "^2.1.0",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.13"
  }
}
