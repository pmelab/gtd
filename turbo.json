{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["package.json", "package-lock.json", "tsconfig.json", "mise.toml"],
  "globalPassThroughEnv": ["CI", "TMPDIR", "TERM", "FORCE_COLOR"],
  "tasks": {
    "build": {
      "inputs": ["src/**", "scripts/**", "tsdown.config.ts"],
      "outputs": ["dist/**", "src/ui/client.generated.html"]
    },
    "format:check": {
      "outputs": []
    },
    "lint": {
      "inputs": [
        "src/**",
        "tests/**",
        "scripts/**",
        "dev/**",
        "evals/**",
        ".storybook/**",
        "*.ts",
        "*.mjs",
        ".oxlintrc.json",
        "claude/**"
      ],
      "outputs": []
    },
    "lint:sh": {
      "inputs": [
        "src/**",
        "scripts/generate-shell-corpus.ts",
        "tests/shell/corpus/**",
        ".shellcheckrc"
      ],
      "outputs": []
    },
    "lint:boundaries": {
      "inputs": [
        "src/**",
        "tests/**",
        "claude/**",
        "scripts/**",
        "tsconfig.json",
        ".dependency-cruiser.mjs"
      ],
      "outputs": []
    },
    "typecheck": {
      "inputs": ["src/**", "tests/**", "evals/**", "scripts/**", "*.ts"],
      "outputs": []
    },
    "analyze": {
      "inputs": [
        "src/**",
        "tests/**",
        "scripts/**",
        "dev/**",
        "evals/**",
        ".storybook/**",
        "*.ts",
        "*.mjs",
        ".oxlintrc.json",
        "package.json",
        ".fallowrc.json",
        "claude/**"
      ],
      "outputs": []
    },
    "test:unit": {
      "env": ["GTD_FLAG_*"],
      "dependsOn": ["build"],
      "inputs": [
        ".oxfmtrc.json",
        "src/**",
        "tests/**",
        "scripts/**",
        "dev/**",
        "vitest.config.ts",
        "vitest.stryker.config.ts",
        "stryker.config.json",
        "turbo.json",
        "docs/**",
        "COMPATIBILITY.md",
        "README.md",
        "SDLC.md",
        "evals/**",
        ".dependency-cruiser.mjs",
        "claude/**",
        "package.json",
        ".releaserc.json",
        "commitlint.config.mjs",
        ".github/workflows/**",
        "gtd.config.ts",
        ".gtdrc*",
        "gtd.config.json",
        "gtd.config.yaml",
        "tsdown.config.ts",
        ".claude-plugin/**",
        "hooks/**",
        "bin/**"
      ],
      "outputs": []
    },
    "test:workflows": {
      "env": ["GTD_FLAG_*"],
      "dependsOn": ["build"],
      "inputs": ["src/**", "tests/vitest.*.ts", "vitest.config.ts"],
      "outputs": []
    },
    "test:e2e:inmem": {
      "env": ["GTD_FLAG_*"],
      "dependsOn": ["build"],
      "inputs": [
        "src/**",
        "tests/integration/**",
        "tests/vitest.*.ts",
        "vitest.config.ts",
        "docs/**",
        ".claude/skills/**"
      ],
      "outputs": []
    },
    "test:e2e:live": {
      "env": ["GTD_FLAG_*"],
      "dependsOn": ["build"],
      "inputs": [
        "src/**",
        "tests/integration/**",
        "tests/vitest.*.ts",
        "vitest.config.ts",
        "docs/**",
        ".claude/skills/**"
      ],
      "outputs": []
    },
    "test:web": {
      "env": ["GTD_FLAG_*"],
      "inputs": ["src/**", ".storybook/**", "vitest.config.ts", "!src/ui/client.generated.html"],
      "outputs": []
    }
  }
}
