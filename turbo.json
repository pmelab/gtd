{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": ["package.json", "package-lock.json", "tsconfig.json", "mise.toml"],
  "globalPassThroughEnv": ["CI", "TMPDIR", "TERM", "FORCE_COLOR"],
  "tasks": {
    "build": {
      "inputs": ["src/**", "scripts/**", "tsdown.config.ts"],
      "outputs": ["dist/**", "schema.json", "src/web/generated.html"]
    },
    "format:check": {
      "outputs": []
    },
    "lint": {
      "inputs": [
        "src/**",
        "tests/**",
        "scripts/**",
        "dev/**",
        "evals/**",
        ".storybook/**",
        "*.ts",
        "*.mjs",
        ".oxlintrc.json"
      ],
      "outputs": []
    },
    "lint:sh": {
      "inputs": [
        "src/**",
        "scripts/generate-shell-corpus.ts",
        "tests/shell/corpus/**",
        ".shellcheckrc"
      ],
      "outputs": []
    },
    "typecheck": {
      "inputs": ["src/**", "tests/**", "evals/**", "*.ts"],
      "outputs": []
    },
    "analyze": {
      "inputs": [
        "src/**",
        "tests/**",
        "scripts/**",
        "dev/**",
        "evals/**",
        ".storybook/**",
        "*.ts",
        "*.mjs",
        ".oxlintrc.json",
        "package.json",
        ".fallowrc.json"
      ],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["build"],
      "inputs": [
        "src/**",
        "tests/**",
        "scripts/**",
        "dev/**",
        "vitest.config.ts",
        "vitest.stryker.config.ts",
        "stryker.config.json",
        "turbo.json",
        "docs/**",
        "evals/**"
      ],
      "outputs": []
    },
    "test:e2e:inmem": {
      "dependsOn": ["build"],
      "inputs": [
        "src/**",
        "tests/integration/**",
        "tests/vitest.*.ts",
        "vitest.config.ts",
        "docs/**"
      ],
      "outputs": []
    },
    "test:e2e:live": {
      "dependsOn": ["build"],
      "inputs": [
        "src/**",
        "tests/integration/**",
        "tests/vitest.*.ts",
        "vitest.config.ts",
        "docs/**"
      ],
      "outputs": []
    },
    "test:web": {
      "inputs": ["src/**", ".storybook/**", "vitest.config.ts", "!src/web/generated.html"],
      "outputs": []
    }
  }
}
