{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.stryker.config.ts" },
  "mutate": [
    "src/replay/Replay.ts",
    "src/replay/Trailers.ts",
    "src/edge/Edge.ts",
    "src/lsp/Lsp.ts",
    "src/steering/Widgets.ts",
    "src/steering/WidgetRules.ts",
    "src/steering/Serialize.ts",
    "src/steering/widget.ts",
    "src/steering/index.ts",
    "src/step/planStep.ts",
    "src/workflow/load.ts",
    "src/workflow/compile.ts",
    "src/platform/Git.ts",
    "src/wire/Demand.ts"
  ],
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "ignoreStatic": true,
  "reporters": ["html", "clear-text", "progress"]
}
