  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one yellow action on a card: Proceed, Save.",
      "html": "<button class=\"ds-btn-primary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polygon points=\"6 3 20 12 6 21 6 3\"/></svg>Proceed</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 16px;border:0;border-radius:6px;background:var(--color-primary,#ffc328);color:var(--color-primary-foreground,#151a1d);font:500 14px/1 system-ui,sans-serif;transition:scale .15s ease-out}.ds-btn-primary:hover{background:color-mix(in srgb,var(--color-primary-pressed,#e6a800) 80%,transparent)}.ds-btn-primary:active{background:var(--color-primary-pressed,#e6a800);scale:.96}.ds-btn-primary:focus-visible{outline:2px solid var(--color-ring,#151a1d);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Default button: Retry, Open, New worktree.",
      "html": "<button class=\"ds-btn-secondary\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8\"/><path d=\"M3 3v5h5\"/></svg>Retry</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 16px;border:1px solid var(--color-border,#dcddd9);border-radius:6px;background:var(--color-card,#fafaf7);color:var(--color-foreground,#151a1d);box-shadow:0 1px 2px rgb(21 26 29 / 0.05);font:500 14px/1 system-ui,sans-serif;transition:scale .15s ease-out}.ds-btn-secondary:hover,.ds-btn-secondary:active{background:var(--color-accent,#e8e8e4)}.ds-btn-secondary:active{scale:.96}.ds-btn-secondary:focus-visible{outline:2px solid var(--color-ring,#151a1d);outline-offset:2px}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Destructive actions only.",
      "html": "<button class=\"ds-btn-danger\">Discard</button>",
      "css": ".ds-btn-danger{display:inline-flex;align-items:center;min-height:44px;padding:0 16px;border:1px solid color-mix(in srgb,var(--color-destructive,#c4283a) 50%,transparent);border-radius:6px;background:var(--color-card,#fafaf7);color:var(--color-destructive,#c4283a);font:500 14px/1 system-ui,sans-serif;transition:scale .15s ease-out}.ds-btn-danger:hover,.ds-btn-danger:active{background:var(--color-destructive,#c4283a);color:var(--color-destructive-foreground,#fafaf7)}.ds-btn-danger:active{scale:.96}.ds-btn-danger:focus-visible{outline:2px solid var(--color-ring,#151a1d);outline-offset:2px}"
    },
    {
      "name": "Status Badges",
      "kind": "chip",
      "refersTo": "badge-needs-you",
      "description": "Worktree status: icon, word and colour together.",
      "html": "<span class=\"ds-badge ds-badge-needs\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><line x1=\"12\" x2=\"12\" y1=\"8\" y2=\"12\"/><line x1=\"12\" x2=\"12.01\" y1=\"16\" y2=\"16\"/></svg>needs you (question)</span> <span class=\"ds-badge ds-badge-error\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m15 9-6 6\"/><path d=\"m9 9 6 6\"/></svg>error (crashed)</span> <span class=\"ds-badge ds-badge-idle\">idle</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:4px;padding:2px 6px;border:1px solid transparent;border-radius:6px;font:500 12px/16px system-ui,sans-serif;font-variant-numeric:tabular-nums;white-space:nowrap}.ds-badge-needs{background:var(--color-primary,#ffc328);color:var(--color-primary-foreground,#151a1d)}.ds-badge-error{background:var(--color-destructive,#c4283a);color:var(--color-destructive-foreground,#fafaf7)}.ds-badge-idle{background:var(--color-muted,#ebebe7);color:var(--color-muted-foreground,#596066)}"
    },
    {
      "name": "Worktree Card",
      "kind": "card",
      "refersTo": "card",
      "description": "One worktree that needs you: title line, badge, reason, one action.",
      "html": "<article class=\"ds-card\"><div class=\"ds-card-head\"><h2><span class=\"ds-muted\">Portal / </span><b>plan</b></h2><span class=\"ds-badge-y\">needs you</span></div><p>Answer the plan</p><button class=\"ds-card-btn\">Proceed</button></article>",
      "css": ".ds-card{display:flex;flex-direction:column;gap:12px;padding:16px;border:1px solid var(--color-border,#dcddd9);border-radius:8px;background:var(--color-card,#fafaf7);color:var(--color-foreground,#151a1d);box-shadow:0 1px 2px rgb(21 26 29 / 0.05);font:400 14px/1.43 system-ui,sans-serif;max-width:358px}.ds-card-head{display:flex;justify-content:space-between;gap:12px}.ds-card h2{margin:0;font-size:16px;font-weight:400}.ds-card b{font-weight:600}.ds-card p{margin:0}.ds-muted{color:var(--color-muted-foreground,#596066)}.ds-badge-y{padding:2px 6px;border-radius:6px;background:var(--color-primary,#ffc328);color:#151a1d;font:500 12px/16px system-ui}.ds-card-btn{min-height:44px;border:0;border-radius:6px;background:var(--color-primary,#ffc328);color:#151a1d;font:500 14px system-ui}"
    },
    {
      "name": "Segmented Tabs",
      "kind": "nav",
      "refersTo": "tabs-list",
      "description": "Detail pane Gate / Actions switch.",
      "html": "<div class=\"ds-tabs\"><button class=\"ds-tab\" aria-selected=\"true\">Gate</button><button class=\"ds-tab\">Actions</button></div>",
      "css": ".ds-tabs{display:inline-flex;padding:4px;border-radius:8px;background:var(--color-muted,#ebebe7)}.ds-tab{min-height:44px;padding:0 12px;border:0;border-radius:6px;background:transparent;color:var(--color-muted-foreground,#596066);font:500 14px system-ui,sans-serif;transition:color .15s}.ds-tab:hover{color:var(--color-foreground,#151a1d)}.ds-tab[aria-selected=true]{background:var(--color-card,#fafaf7);color:var(--color-foreground,#151a1d);box-shadow:0 1px 2px rgb(21 26 29 / .08)}.ds-tab:focus-visible{outline:2px solid var(--color-ring,#151a1d)}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Single-line field; 16px text avoids iOS zoom.",
      "html": "<input class=\"ds-input\" placeholder=\"Worktree name\">",
      "css": ".ds-input{width:100%;height:44px;padding:0 12px;border:1px solid var(--color-input,#82888c);border-radius:6px;background:var(--color-card,#fafaf7);color:var(--color-foreground,#151a1d);font:400 16px system-ui,sans-serif;outline:none;transition:border-color .15s}.ds-input::placeholder{color:var(--color-muted-foreground,#596066)}.ds-input:focus-visible{border-color:var(--color-foreground,#151a1d);outline:2px solid var(--color-ring,#151a1d);outline-offset:1px}"
    },
    {
      "name": "Error Notice",
      "kind": "custom",
      "refersTo": "card",
      "description": "Says what broke; red tint, icon, foreground text.",
      "html": "<div class=\"ds-alert\" role=\"alert\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m15 9-6 6\"/><path d=\"m9 9 6 6\"/></svg><div><b>Workspace settings not reloaded</b><p>workspace.x: unknown key</p></div></div>",
      "css": ".ds-alert{display:grid;grid-template-columns:20px 1fr;gap:4px 12px;padding:12px 16px;border:1px solid color-mix(in srgb,var(--color-destructive,#c4283a) 40%,transparent);border-radius:8px;background:color-mix(in srgb,var(--color-destructive,#c4283a) 8%,transparent);color:var(--color-foreground,#151a1d);font:400 14px/1.43 system-ui,sans-serif}.ds-alert svg{color:var(--color-destructive,#c4283a)}.ds-alert b{font-weight:500}.ds-alert p{margin:0;color:var(--color-muted-foreground,#596066)}"
    },
    {
      "name": "Bottom Tab Bar",
      "kind": "nav",
      "refersTo": "tabs-trigger-active",
      "description": "Phone navigation with icon, label and count.",
      "html": "<nav class=\"ds-tabbar\"><button aria-current=\"true\"><span class=\"ds-pill\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" style=\"margin-top:4px\"><path d=\"M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z\"/></svg><i>2</i></span>Now</button><button><span class=\"ds-pill\"></span>Projects</button><button><span class=\"ds-pill\"><i class=\"m\">2</i></span>Inbox</button></nav>",
      "css": ".ds-tabbar{display:flex;border-top:1px solid var(--color-border,#dcddd9);background:var(--color-card,#fafaf7);max-width:390px}.ds-tabbar button{flex:1;min-height:56px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;border:0;background:none;color:var(--color-muted-foreground,#596066);font:400 12px system-ui}.ds-tabbar button[aria-current=true]{color:var(--color-foreground,#151a1d);font-weight:600}.ds-pill{position:relative;width:56px;height:28px;border-radius:999px}[aria-current=true] .ds-pill{background:var(--color-accent,#e8e8e4)}.ds-pill i{position:absolute;top:-4px;left:32px;min-width:20px;height:20px;border-radius:999px;background:var(--color-primary,#ffc328);color:#151a1d;font:600 12px/20px system-ui;font-style:normal}.ds-pill i.m{background:var(--color-muted,#ebebe7);color:var(--color-muted-foreground,#596066)}"
    }
  ],
  "narrative": {
    "northStar": "The Quiet Control Room",
    "overview": "A shadcn-style product UI played straight, at the craft bar of Linear and Vercel\ndashboards, in gtd's own four-colour base: charcoal, yellow, warm white and a\nmuted grey. The ground is a pale warm grey; content sits on near-white cards\nwith one hairline border and a barely-there shadow. Almost everything is\nneutral, so the one yellow thing on a screen is the thing to do.\n\nDensity is moderate: one card per worktree, one reason sentence, one action.\nStatus is always a badge with an icon and a word, never a glyph or colour alone.\nThe system replaces an earlier look of hairline-boxed screens where every word\nhad the same weight; hierarchy now comes from size, weight and the\nmuted/foreground split.",
    "keyCharacteristics": [
      "Neutral warm-grey surfaces; yellow and red are reserved signals.",
      "Cards (8px) hold content; controls (6px) act on it.",
      "System sans, three weights, tabular numbers for counts.",
      "Lucide line icons at 16px, stroke 2.",
      "Phone first with a 44px touch floor; a three-column split from 1024px.",
      "Light and dark follow the OS; every UI token has a dark value."
    ],
    "rules": [
      {
        "name": "The One Yellow Rule",
        "body": "Yellow means \"act here\" and nothing else: the primary",
        "section": "colors"
      },
      {
        "name": "The Red Is Broken Rule",
        "body": "Red appears only when something failed: an error",
        "section": "colors"
      },
      {
        "name": "The Never Colour Alone Rule",
        "body": "Every status carries an icon and a word next to",
        "section": "colors"
      },
      {
        "name": "The Title Line Rule",
        "body": "A worktree is named \"Project / worktree\" on one line:",
        "section": "typography"
      },
      {
        "name": "The 16px Field Rule",
        "body": "Every text field renders at 16px or larger so iOS does",
        "section": "typography"
      },
      {
        "name": "The Thumb Floor Rule",
        "body": "Below 1024px every control is at least 44 by 44px.",
        "section": "layout"
      },
      {
        "name": "The One Soft Shadow Rule",
        "body": "Surfaces at rest get at most the 1px card shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** give each card at most one yellow action; make every other action",
      "**Do** pair every status colour with a Lucide icon and a word.",
      "**Do** keep controls at 44px below 1024px.",
      "**Do** write errors as what broke plus a Retry.",
      "**Do** define every new colour for both light and dark and check it against",
      "**Do** use tabular numbers for every count."
    ],
    "donts": [
      "**Don't** use yellow for warnings, info, headings, links or decoration.",
      "**Don't** use red for anything but failure.",
      "**Don't** put a separate label, eyebrow or uppercase kicker above a title.",
      "**Don't** box every line in its own hairline; group content on cards and let",
      "**Don't** use Unicode glyphs or emoji as icons.",
      "**Don't** animate a control with a keyframe or slide content under a reaching"
    ]
  }
}
